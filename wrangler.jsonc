// Cloudflare deployment settings. The site is purely static: Cloudflare only
// serves the files in dist/ (no Worker code, no server). Static requests are free.
{
  "$schema": "https://unpkg.com/wrangler@4.147.0/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "portfolio",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./dist",
    // Unknown addresses show our own 404 page.
    "not_found_handling": "404-page"
  },
  // Lets Cloudflare build a preview URL for every non-main branch (`wrangler preview`).
  // Empty on purpose: previews reuse the settings above.
  "previews": {}
}
