---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { profile, githubUrl } from '../config/site';
import { themeStyle, type ThemeId } from '../config/themes';
import { localizedPath, useTranslations } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  /** Absolute path of a social preview image inside /public. */
  image?: string;
  /** Colour theme for the whole page; projects pass their own. */
  theme?: ThemeId;
}

const locale = Astro.currentLocale ?? 'en';
const t = useTranslations(locale);
const { title, description = t('site.description'), image, theme = 'aurora' } = Astro.props;

const pageTitle = title ? `${title} · ${t('site.title')}` : t('site.title');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;

const navItems = [
  { href: localizedPath('/', locale), label: t('nav.home') },
  { href: localizedPath('/projects/', locale), label: t('nav.projects') },
  { href: localizedPath('/about/', locale), label: t('nav.about') },
  { href: localizedPath('/cv/', locale), label: t('nav.cv') },
];
const contactHref = localizedPath('/contact/', locale);

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  return target === '/' ? current === '/' : current.startsWith(target);
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="l4PK8qXlnmCyN9o4l8bM3JZcuYakhCnEQZ17JACWcvg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#050608" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
  </head>
  <body style={themeStyle(theme)}>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href={localizedPath('/', locale)}>
          <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="#fff" />
            <path d="M5 18c4-4 7-4 11 0s7 4 11 0v9H5z" fill="#07080b" />
            <path d="M5 18c4-4 7-4 11 0s7 4 11 0" fill="none" stroke="var(--accent)" stroke-width="2" />
          </svg>
          {profile.name}
        </a>
        <nav aria-label="Main">
          <ul class="nav-list">
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a class="nav-cta" href={contactHref} aria-current={isCurrent(contactHref) ? 'page' : undefined}>
                {t('nav.contact')}
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <slot name="hero" />

    <main id="main" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p>© {new Date().getFullYear()} {profile.name}</p>
        <p class="muted">{t('footer.built')}</p>
        <p><a href={`${githubUrl}/Portfolio`}>{t('footer.source')}</a></p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 0.5rem;
    top: -3rem;
    padding: 0.5rem 0.9rem;
    background: #fff;
    color: #07080b;
    border-radius: 999px;
    z-index: 20;
  }

  .skip-link:focus {
    top: 0.5rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(5 6 8 / 0.72);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.85rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--color-text);
  }

  .brand__mark {
    width: 1.75rem;
    height: 1.75rem;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem clamp(0.9rem, 3vw, 2.2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-list a {
    color: var(--color-muted);
    font-size: 0.95rem;
    text-decoration: none;
    padding: 0.3rem 0;
    display: inline-block;
    transition: color 0.2s;
  }

  .nav-list a:hover,
  .nav-list a[aria-current='page'] {
    color: var(--color-text);
  }

  .nav-list a:not(.nav-cta)[aria-current='page'] {
    box-shadow: 0 2px 0 var(--accent);
  }

  .nav-list .nav-cta {
    padding: 0.4rem 1.1rem;
    border-radius: 999px;
    background: #fff;
    color: #07080b;
    font-weight: 500;
  }

  .nav-list .nav-cta:hover,
  .nav-list .nav-cta[aria-current='page'] {
    color: #07080b;
    background: #e7ebf3;
  }

  .first-version {
    margin: 0;
    color: var(--color-faint);
    font-size: 0.8rem;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--color-border);
  }

  .first-version .container {
    display: block;
  }

  .first-version__dot {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.55rem;
    border-radius: 50%;
    background: var(--color-pending-text);
    vertical-align: 0.08em;
  }

  main {
    padding-block: 3rem 5rem;
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    font-size: 0.88rem;
    color: var(--color-muted);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
    padding-block: 1.75rem;
  }

  .site-footer p {
    margin: 0;
  }
</style>
