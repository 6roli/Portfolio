---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { localizedPath, useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
---

<BaseLayout title={t('notFound.title')}>
  <PageHeader slot="hero" eyebrow="404" title={t('notFound.title')} lead={t('notFound.body')} />
  <p><a class="button" href={localizedPath('/', Astro.currentLocale)}>{t('notFound.home')}</a></p>
</BaseLayout>
