---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pending from '../../components/Pending.astro';
import ChatReplay from '../../components/ChatReplay.astro';
import { render } from 'astro:content';
import { localizedPath, useTranslations, defaultLocale } from '../../i18n';
import { getProjects, projectSlug, type Project } from '../../lib/projects';
import type { UiKey } from '../../i18n/en';

export const getStaticPaths = (async () => {
  const projects = await getProjects(defaultLocale);
  return projects.map((project) => ({ params: { slug: projectSlug(project) }, props: { project } }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const data = project.data;
const t = useTranslations(Astro.currentLocale);
// Optional free-form Markdown below the front matter (e.g. code walkthrough).
const { Content } = await render(project);
const hasBody = Boolean(project.body?.trim());

// Fixed order so every project page answers the same questions.
const sections: { key: keyof typeof data; label: UiKey }[] = [
  { key: 'problem', label: 'projects.problem' },
  { key: 'data', label: 'projects.data' },
  { key: 'method', label: 'projects.method' },
  { key: 'results', label: 'projects.results' },
  { key: 'limitations', label: 'projects.limitations' },
];
---

<BaseLayout title={data.title} description={data.summary} image={data.image?.src}>
  <p><a href={localizedPath('/projects/', Astro.currentLocale)}>← {t('projects.back')}</a></p>

  <article class="project">
    <header class="reading">
      <p class="status">{t(`projects.status.${data.status}`)}</p>
      <h1>{data.title}</h1>
      <p class="lead">{data.summary}</p>
      <div class="actions">
        {data.demoUrl && <a class="button" href={data.demoUrl}>{data.demoLabel ?? t('projects.demo')} ↗</a>}
        {
          data.repoUrl && data.repoIsPublic && (
            <a class="button button--ghost" href={data.repoUrl}>
              {t('projects.code')} ↗
            </a>
          )
        }
        {data.repoUrl && !data.repoIsPublic && <span class="muted">{t('projects.codePrivate')}</span>}
      </div>
      {data.demoNote && <p class="demo-note muted">{data.demoNote}</p>}
    </header>

    {data.transcript && <ChatReplay {...data.transcript} title={data.title} />}

    {
      data.image && !data.transcript && (
        <figure class="hero-figure">
          <img src={data.image.src} alt={data.image.alt} width="1200" height="550" />
          {data.image.credit && <figcaption>{data.image.credit}</figcaption>}
        </figure>
      )
    }

    {data.needsReview && <p class="review-note">{t('projects.needsReview')}</p>}

    <div class="reading">
      {
        sections.map(({ key, label }) => {
          const text = data[key] as string | null;
          return (
            <section>
              <h2>{t(label)}</h2>
              {text ? <p>{text}</p> : <Pending />}
            </section>
          );
        })
      }

      <section>
        <h2>{t('projects.architecture')}</h2>
        {data.architecture ? <p>{data.architecture}</p> : <Pending />}
      </section>
    </div>

    {
      data.architectureImage && (
        <figure class="diagram">
          <img src={data.architectureImage.src} alt={data.architectureImage.alt} width="960" height="620" loading="lazy" />
        </figure>
      )
    }

    <div class="reading">
      <section>
        <h2>{t('projects.technologies')}</h2>
        <ul class="tag-list">
          {data.technologies.map((tech) => <li class="tag">{tech}</li>)}
        </ul>
      </section>

      {
        hasBody && (
          <div class="body">
            <Content />
          </div>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .demo-note {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
  }

  .diagram {
    margin: 1.25rem 0 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.5rem;
    overflow-x: auto;
  }

  .diagram img {
    width: 100%;
    min-width: 40rem;
  }

  /* Markdown body: code blocks and tables. */
  .body :global(pre) {
    padding: 1rem;
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 0.85rem;
  }

  .body :global(table) {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.93rem;
  }

  .body :global(th),
  .body :global(td) {
    text-align: left;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }

  .status {
    margin: 0 0 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-figure {
    margin: 2rem 0 0;
  }

  .hero-figure img {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  figcaption {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .review-note {
    margin-top: 1.5rem;
    max-width: var(--reading-width);
    border-left: 3px solid var(--color-pending-border);
    background: var(--color-pending-bg);
    color: var(--color-pending-text);
    padding: 0.6rem 0.9rem;
  }
</style>
