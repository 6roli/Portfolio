---
/**
 * About, first version: only the working method as a tree. The background,
 * evidence and AI sections are kept in src/config/about.ts and will return
 * further down the page behind a "See more" link once they are complete.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import NeonTree from '../components/NeonTree.astro';
import { about } from '../config/about';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
---

<BaseLayout title={t('about.title')} theme="moss">
  <section class="method" aria-labelledby="method-title">
    <p class="eyebrow">{t('about.approach')}</p>
    <h1 id="method-title">{t('about.approachTitle')}</h1>
    <NeonTree stages={about.stages} />
  </section>
</BaseLayout>

<style>
  .method {
    text-align: center;
  }

  .method :global(figcaption) {
    text-align: left;
  }

  h1 {
    font-weight: 400;
    letter-spacing: -0.035em;
    margin-bottom: 0;
  }
</style>
