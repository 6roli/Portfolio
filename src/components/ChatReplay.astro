---
/**
 * Replays a real conversation recorded from a live demo. Messages appear one
 * after another with CSS only (no JavaScript). With reduced motion, all are
 * shown at once.
 */
interface Props {
  caption: string;
  messages: { from: 'user' | 'bot'; text: string }[];
  title: string;
}

const { caption, messages, title } = Astro.props;
---

<figure class="replay">
  <div class="replay__window" role="log" aria-label={`Recorded conversation with ${title}`}>
    <div class="replay__bar" aria-hidden="true">
      <span></span><span></span><span></span>
      <p>{title}</p>
    </div>
    <ol class="replay__messages">
      {
        messages.map((message, index) => (
          <li class={`bubble bubble--${message.from}`} style={`--i: ${index}`}>
            <span class="visually-hidden">{message.from === 'user' ? 'Visitor:' : 'Chatbot:'}</span>
            {message.text}
          </li>
        ))
      }
    </ol>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .replay {
    margin: 0;
  }

  .replay__window {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 80px -40px color-mix(in srgb, var(--accent) 60%, transparent);
    overflow: hidden;
  }

  .replay__bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1rem;
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-muted);
  }

  .replay__bar span {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.18);
  }

  .replay__bar p {
    margin: 0 0 0 0.5rem;
    font-weight: 500;
    font-size: 0.9rem;
  }

  .replay__messages {
    list-style: none;
    margin: 0;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    background:
      radial-gradient(60% 50% at 100% 100%, color-mix(in srgb, var(--accent-2) 10%, transparent), transparent),
      var(--color-surface);
  }

  .bubble {
    max-width: min(36rem, 88%);
    padding: 0.6rem 0.85rem;
    border-radius: 14px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.95rem;
    line-height: 1.5;
    animation: appear 0.5s ease-out both;
    animation-delay: calc(var(--i) * 1s);
  }

  .bubble--user {
    align-self: flex-end;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #07080b;
    border-bottom-right-radius: 4px;
  }

  .bubble--bot {
    align-self: flex-start;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    border-bottom-left-radius: 4px;
  }

  @keyframes appear {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
</style>
