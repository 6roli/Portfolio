---
import { localizedPath, useTranslations } from '../i18n';
import { projectSlug, type Project } from '../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, image, technologies, status } = project.data;
const t = useTranslations(Astro.currentLocale);
const href = localizedPath(`/projects/${projectSlug(project)}/`, Astro.currentLocale);
---

<article class="card">
  {
    image ? (
      <img class="card__image" src={image.src} alt={image.alt} loading="lazy" width="600" height="275" />
    ) : (
      <div class="card__image card__image--empty" aria-hidden="true" />
    )
  }
  <div class="card__body">
    <p class="card__status">{t(`projects.status.${status}`)}</p>
    <h3><a href={href} class="card__link">{title}</a></h3>
    <p class="muted">{summary}</p>
    <ul class="tag-list" aria-label={t('projects.technologies')}>
      {technologies.map((tech) => <li class="tag">{tech}</li>)}
    </ul>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .card:hover {
    border-color: var(--color-accent);
  }

  .card__image {
    width: 100%;
    aspect-ratio: 600 / 275;
    object-fit: cover;
    background: var(--color-accent-soft);
  }

  /* Neutral horizon pattern for projects without a real image yet. */
  .card__image--empty {
    background: linear-gradient(to bottom, var(--color-accent-soft) 0 60%, var(--color-border) 60% 62%, var(--color-bg) 62%);
  }

  .card__body {
    padding: 1rem 1.1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .card__status {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }

  .card__link {
    color: var(--color-text);
    text-decoration: none;
  }

  /* Whole card is clickable through the title link. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__link:focus-visible {
    outline: none;
  }

  .card:has(.card__link:focus-visible) {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .tag-list {
    margin-top: auto;
    padding-top: 0.5rem;
  }
</style>
