---
import { localizedPath, useTranslations } from '../i18n';
import { projectSlug, type Project } from '../lib/projects';
import { themeStyle } from '../config/themes';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, image, technologies, status, theme } = project.data;
const t = useTranslations(Astro.currentLocale);
const href = localizedPath(`/projects/${projectSlug(project)}/`, Astro.currentLocale);
---

<article class="card" style={themeStyle(theme)}>
  <div class="card__media">
    {
      image ? (
        <img class="card__image" src={image.src} alt={image.alt} loading="lazy" width="600" height="275" />
      ) : (
        <div class="card__image card__image--empty" aria-hidden="true" />
      )
    }
  </div>
  <div class="card__body">
    <p class="card__status"><span class:list={['card__dot', `card__dot--${status}`]} aria-hidden="true"></span>{t(`projects.status.${status}`)}</p>
    <h3><a href={href} class="card__link">{title}</a></h3>
    <p class="muted">{summary}</p>
    <ul class="tag-list" aria-label={t('projects.technologies')}>
      {technologies.map((tech) => <li class="tag">{tech}</li>)}
    </ul>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, var(--color-surface-2), var(--color-surface));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      border-color 0.25s,
      transform 0.25s,
      box-shadow 0.25s;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    box-shadow: 0 20px 60px -25px color-mix(in srgb, var(--accent) 55%, transparent);
    transform: translateY(-3px);
  }

  .card__media {
    position: relative;
    margin: 0.5rem 0.5rem 0;
    border-radius: calc(var(--radius-lg) - 6px);
    overflow: hidden;
  }

  /* Project colour washes over the bottom of the image. */
  .card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, color-mix(in srgb, var(--accent-2) 30%, transparent));
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .card__image {
    width: 100%;
    aspect-ratio: 600 / 275;
    object-fit: cover;
    background: var(--color-surface-2);
  }

  /* Liquid horizon for projects without a real image yet. */
  .card__image--empty {
    background:
      radial-gradient(120% 60% at 50% 100%, color-mix(in srgb, var(--accent-2) 45%, transparent), transparent 70%),
      linear-gradient(180deg, #000 0 48%, var(--accent) 50%, color-mix(in srgb, var(--accent-2) 40%, #000) 58%, #000);
  }

  .card__body {
    padding: 1.1rem 1.3rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }

  .card__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-size: 0.76rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-text);
  }

  .card__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-faint);
  }

  .card__dot--live {
    background: #4ade80;
    box-shadow: 0 0 8px #4ade80;
  }

  .card__dot--in-progress {
    background: #facc15;
  }

  .card h3 {
    font-size: 1.3rem;
    font-weight: 500;
  }

  .card p.muted {
    font-size: 0.95rem;
  }

  .card__link {
    color: var(--color-text);
    text-decoration: none;
  }

  .card__link:hover {
    color: var(--color-text);
  }

  /* Whole card is clickable through the title link. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__link:focus-visible {
    outline: none;
  }

  .card:has(.card__link:focus-visible) {
    outline: 2px solid var(--accent-text);
    outline-offset: 3px;
  }

  .tag-list {
    margin-top: auto;
    padding-top: 0.6rem;
  }
</style>
