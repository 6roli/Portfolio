---
/**
 * Top band of secondary pages: same glow as the home hero, smaller. Place it
 * in the layout's "hero" slot: <PageHeader slot="hero" … />.
 */
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
}

const { title, eyebrow, lead } = Astro.props;
---

<header class="page-header">
  <div class="container page-header__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    border-bottom: 1px solid var(--color-border);
    background:
      radial-gradient(45% 90% at 90% 110%, color-mix(in srgb, var(--accent-2) 22%, transparent), transparent 70%),
      radial-gradient(30% 60% at 100% 20%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%),
      var(--color-bg);
  }

  .page-header__inner {
    padding-block: clamp(2.75rem, 8vw, 5rem) clamp(2rem, 5vw, 3rem);
  }

  h1 {
    font-weight: 400;
    letter-spacing: -0.035em;
  }

  .lead:last-child {
    margin-bottom: 0;
  }
</style>
