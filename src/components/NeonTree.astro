---
/**
 * The working method as a large, glowing tree: roots (1), sprouts (2), trunk (3)
 * and branches (4), each labelled with the title of its stage.
 *
 * The tree is generated at build time by a small recursive branching model with a
 * fixed seed, so it looks organic but is identical on every build. It is static
 * SVG (no JavaScript, no animation). The SVG is decorative for screen readers; the
 * ordered list below it carries the same content and replaces the in-drawing
 * labels on narrow screens.
 */
import type { Stage, TreePart } from '../config/about';

interface Props {
  stages: Stage[];
}

const { stages } = Astro.props;

// --- Deterministic random numbers (mulberry32) -----------------------------
function random(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = random(20261019);
const between = (min: number, max: number) => min + rnd() * (max - min);
const pick = <T,>(items: readonly T[]) => items[Math.floor(rnd() * items.length)];

// Wide canvas: the tree stays in the middle third, labels use the side margins.
const W = 1400;
const H = 1000;
const CX = 700;
const GROUND = 660;
const CROWN = { halfWidth: 330, top: 20 };
const ROOTS = { halfWidth: 300, bottom: 990 };

interface Segment {
  d: string;
  width: number;
  color: string;
}
interface Leaf {
  x: number;
  y: number;
  r: number;
  color: string;
}

const f = (n: number) => n.toFixed(1);

// A slightly curved segment from (x, y) in direction `angle`; returns its end.
function segment(list: Segment[], x: number, y: number, angle: number, length: number, width: number, color: string, bend: number) {
  const ex = x + length * Math.cos(angle);
  const ey = y + length * Math.sin(angle);
  const mx = (x + ex) / 2 + Math.cos(angle + Math.PI / 2) * bend;
  const my = (y + ey) / 2 + Math.sin(angle + Math.PI / 2) * bend;
  list.push({ d: `M${f(x)} ${f(y)} Q${f(mx)} ${f(my)} ${f(ex)} ${f(ey)}`, width, color });
  return { x: ex, y: ey };
}

// --- Branches and canopy ----------------------------------------------------
const branchColors = ['#19f5c9', '#2bff9a', '#3dff6e', '#7dff3a', '#b7ff2a', '#e6ff4a', '#f9f871', '#f9f871'];
const leafColors = ['#b7ff2a', '#e6ff4a', '#39ff88', '#19f5e1', '#f9f871', '#7dffcf'];
const branches: Segment[] = [];
const leaves: Leaf[] = [];
const MAX_DEPTH = 7;

function grow(x: number, y: number, angle: number, length: number, width: number, depth: number) {
  const end = segment(branches, x, y, angle, length, width, branchColors[depth], between(-0.12, 0.12) * length);
  if (depth >= MAX_DEPTH || length < 12) {
    for (let i = 0; i < 4; i++) {
      leaves.push({
        x: end.x + between(-16, 16),
        y: end.y + between(-14, 12),
        r: between(2.2, 5.5),
        color: pick(leafColors),
      });
    }
    return;
  }
  const count = depth < 2 ? 3 : rnd() < 0.3 ? 3 : 2;
  const spread = between(0.36, 0.55);
  for (let i = 0; i < count; i++) {
    const offset = (i - (count - 1) / 2) * spread;
    // Pull every branch slightly back towards "up" so the crown stays rounded.
    const next = angle + offset + between(-0.12, 0.12) + (-Math.PI / 2 - angle) * 0.3;
    grow(end.x, end.y, next, length * between(0.7, 0.82), Math.max(width * 0.68, 1.1), depth + 1);
  }
}

// Trunk: a filled, tapering and slightly leaning shape.
const TRUNK_TOP = 430;
const trunk = `M${CX - 30} ${GROUND} C${CX - 22} ${GROUND - 90} ${CX - 18} ${TRUNK_TOP + 90} ${CX - 12} ${TRUNK_TOP}
  L${CX + 12} ${TRUNK_TOP} C${CX + 16} ${TRUNK_TOP + 90} ${CX + 24} ${GROUND - 90} ${CX + 34} ${GROUND} Z`;
for (const angle of [-Math.PI / 2 - 0.5, -Math.PI / 2 - 0.1, -Math.PI / 2 + 0.16, -Math.PI / 2 + 0.52]) {
  grow(CX + Math.cos(angle) * 4, TRUNK_TOP + 6, angle, between(100, 118), 14, 1);
}

// Scale a generated part around an anchor so it fits its box (keeps the shape, never enlarges).
function fit(points: { x: number; y: number }[], ax: number, ay: number, halfWidth: number, limitY: number) {
  const reachX = Math.max(...points.map((p) => Math.abs(p.x - ax)));
  const reachY = Math.max(...points.map((p) => Math.abs(p.y - ay)));
  const scale = Math.min(1, halfWidth / reachX, Math.abs(limitY - ay) / reachY);
  return `translate(${ax} ${ay}) scale(${scale.toFixed(3)}) translate(${-ax} ${-ay})`;
}
const endPoints = (list: Segment[]) =>
  list.map((s) => {
    const [x, y] = s.d.split(' ').slice(-2).map(Number);
    return { x, y };
  });
const crownTransform = fit([...endPoints(branches), ...leaves], CX, TRUNK_TOP, CROWN.halfWidth, CROWN.top);

// --- Roots --------------------------------------------------------------------
const rootColors = ['#ff2bd6', '#ff3fc0', '#e246ff', '#b84dff', '#8f5bff', '#7a6bff'];
const roots: Segment[] = [];

function root(x: number, y: number, angle: number, length: number, width: number, depth: number) {
  const end = segment(roots, x, y, angle, length, width, rootColors[depth], between(-0.3, 0.3) * length);
  if (depth >= 5 || length < 10) return;
  const count = rnd() < 0.45 ? 3 : 2;
  for (let i = 0; i < count; i++) {
    let next = angle + (i - (count - 1) / 2) * between(0.45, 0.75) + between(-0.15, 0.15);
    next = Math.min(Math.max(next, 0.12), Math.PI - 0.12); // never grow above ground
    root(end.x, end.y, next, length * between(0.62, 0.78), Math.max(width * 0.62, 1), depth + 1);
  }
}
for (const angle of [0.32, 0.95, 1.5, 2.15, 2.8]) {
  root(CX + Math.cos(angle) * 18, GROUND + 2, angle, between(80, 105), 12, 0);
}
const rootTransform = fit(endPoints(roots), CX, GROUND, ROOTS.halfWidth, ROOTS.bottom);

// --- Sprouts: young shoots coming out of the ground ---------------------------
const sprouts = [
  { x: CX - 190, h: 46, lean: -0.35 },
  { x: CX - 140, h: 30, lean: -0.15 },
  { x: CX + 140, h: 40, lean: 0.3 },
  { x: CX + 190, h: 26, lean: 0.4 },
].map(({ x, h, lean }) => {
  const tipX = x + Math.sin(lean) * h;
  const tipY = GROUND - Math.cos(lean) * h;
  return {
    stem: `M${x} ${GROUND} Q${f(x + lean * 18)} ${f(GROUND - h * 0.55)} ${f(tipX)} ${f(tipY)}`,
    leaves: [
      { cx: tipX - 9, cy: tipY - 2, rotate: -35 + lean * 40 },
      { cx: tipX + 9, cy: tipY - 4, rotate: 35 + lean * 40 },
    ],
  };
});

// --- Labels: number badge on the part, title at the side ----------------------
// b = badge on the drawing; l = label baseline at the outer edge.
const anchors: Record<TreePart, { bx: number; by: number; ly: number; side: 'left' | 'right' }> = {
  roots: { bx: CX - 70, by: 820, ly: 850, side: 'left' },
  sprouts: { bx: CX - 190, by: 580, ly: 600, side: 'left' },
  trunk: { bx: CX + 50, by: 560, ly: 580, side: 'right' },
  branches: { bx: CX + 190, by: 230, ly: 190, side: 'right' },
};
const MARGIN = 40;
const TITLE_CHAR = 15; // approximate width of one title character at 28 units
const labels = stages.map((stage, index) => {
  const anchor = anchors[stage.part];
  const left = anchor.side === 'left';
  const lx = left ? MARGIN : W - MARGIN;
  const textEnd = left ? lx + stage.title.length * TITLE_CHAR + 16 : lx - stage.title.length * TITLE_CHAR - 16;
  return { ...stage, ...anchor, n: index + 1, lx, leaderX: textEnd, anchor: left ? 'start' : 'end' };
});
---

<figure class="neon-tree">
  <svg class="neon-tree__svg" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
    <defs>
      <filter id="neon-glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="7" result="wide" />
        <feGaussianBlur in="SourceGraphic" stdDeviation="2" result="tight" />
        <feMerge>
          <feMergeNode in="wide" />
          <feMergeNode in="tight" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
      <linearGradient id="neon-trunk" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#00e5ff" />
        <stop offset="1" stop-color="#19f5c9" />
      </linearGradient>
      <linearGradient id="neon-ground" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fff" stop-opacity="0" />
        <stop offset="0.5" stop-color="#fff" stop-opacity="0.45" />
        <stop offset="1" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
      <radialGradient id="neon-halo">
        <stop offset="0" stop-color="#2bff9a" stop-opacity="0.16" />
        <stop offset="1" stop-color="#2bff9a" stop-opacity="0" />
      </radialGradient>
    </defs>

    <ellipse cx={CX} cy="330" rx="420" ry="320" fill="url(#neon-halo)" />
    <line x1={CX - 480} y1={GROUND} x2={CX + 480} y2={GROUND} stroke="url(#neon-ground)" stroke-width="2" />

    <g filter="url(#neon-glow)" fill="none" stroke-linecap="round" transform={rootTransform}>
      {roots.map((s) => <path d={s.d} stroke={s.color} stroke-width={f(s.width)} />)}
    </g>

    <g filter="url(#neon-glow)">
      <path d={trunk} fill="url(#neon-trunk)" />
      <g transform={crownTransform}>
        <g fill="none" stroke-linecap="round">
          {branches.map((s) => <path d={s.d} stroke={s.color} stroke-width={f(s.width)} />)}
        </g>
        {leaves.map((leaf) => <circle cx={f(leaf.x)} cy={f(leaf.y)} r={f(leaf.r)} fill={leaf.color} opacity="0.9" />)}
      </g>
    </g>

    <g filter="url(#neon-glow)">
      {
        sprouts.map((sprout) => (
          <g>
            <path d={sprout.stem} fill="none" stroke="#c6ff00" stroke-width="3" stroke-linecap="round" />
            {sprout.leaves.map((leaf) => (
              <ellipse
                cx={f(leaf.cx)}
                cy={f(leaf.cy)}
                rx="10"
                ry="4.5"
                fill="#c6ff00"
                transform={`rotate(${f(leaf.rotate)} ${f(leaf.cx)} ${f(leaf.cy)})`}
              />
            ))}
          </g>
        ))
      }
    </g>

    {
      labels.map((label) => (
        <g class="neon-tree__label">
          <line
            x1={label.bx}
            y1={label.by}
            x2={label.leaderX}
            y2={label.ly - 10}
            class="neon-tree__leader"
          />
          <circle cx={label.bx} cy={label.by} r="17" class="neon-tree__badge" />
          <text x={label.bx} y={label.by + 6} class="neon-tree__badge-text">
            {label.n}
          </text>
          <text x={label.lx} y={label.ly - 34} text-anchor={label.anchor} class="neon-tree__part">
            {String(label.n).padStart(2, '0')} · {label.partLabel}
          </text>
          <text x={label.lx} y={label.ly} text-anchor={label.anchor} class="neon-tree__title">
            {label.title}
          </text>
        </g>
      ))
    }
  </svg>

  <figcaption>
    <ol class="neon-tree__list">
      {
        labels.map((label) => (
          <li>
            <span class="neon-tree__list-badge" aria-hidden="true">
              {label.n}
            </span>
            <span>
              <span class="neon-tree__list-part">{label.partLabel}</span>
              {label.title}
            </span>
          </li>
        ))
      }
    </ol>
  </figcaption>
</figure>

<style>
  .neon-tree {
    overflow: clip;
    margin: 0 auto;
    max-width: 76rem;
  }

  .neon-tree__svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .neon-tree__leader {
    stroke: rgb(255 255 255 / 0.22);
    stroke-width: 1.5;
    stroke-dasharray: 4 6;
  }

  .neon-tree__badge {
    fill: #050608;
    stroke: #fff;
    stroke-width: 2;
  }

  .neon-tree__badge-text {
    fill: #fff;
    font: 600 18px var(--font-sans);
    text-anchor: middle;
  }

  .neon-tree__part {
    fill: #7dffcf;
    font: 500 17px var(--font-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .neon-tree__title {
    fill: var(--color-text);
    font: 500 28px var(--font-sans);
    letter-spacing: -0.02em;
  }

  /* On wide screens the labels live inside the drawing; the list stays for screen readers. */
  .neon-tree__list {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* On narrow screens the drawing keeps only the number badges and the list is shown. */
  @media (max-width: 46rem) {
    .neon-tree__leader,
    .neon-tree__part,
    .neon-tree__title {
      display: none;
    }

    /* Crop the empty side margins so the tree fills the phone width. */
    .neon-tree__svg {
      margin-inline: -27%;
      width: 154%;
      max-width: none;
    }

    .neon-tree__list {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      white-space: normal;
      list-style: none;
      margin: 1rem 0 0;
      padding: 0;
      display: grid;
      gap: 0.6rem;
    }

    .neon-tree__list li {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      padding: 0.8rem 1rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      background: var(--color-surface);
      font-size: 1.05rem;
    }

    .neon-tree__list-badge {
      flex: none;
      display: grid;
      place-items: center;
      width: 1.9rem;
      height: 1.9rem;
      border: 1.5px solid #fff;
      border-radius: 50%;
      font-weight: 600;
      font-size: 0.9rem;
    }

    .neon-tree__list-part {
      display: block;
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #7dffcf;
    }
  }
</style>
