{
  // Works in GitHub Codespaces (browser or VS Code) and in VS Code Dev Containers locally.
  "name": "portfolio",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "postCreateCommand": "npm ci && npx astro telemetry disable",
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": { "label": "Astro dev server", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["astro-build.astro-vscode", "esbenp.prettier-vscode", "editorconfig.editorconfig"]
    },
    "codespaces": {
      "openFiles": ["README.md", "src/config/site.ts"]
    }
  },
  // The smallest Codespaces machine (2 cores) is enough and uses the free quota slowest.
  "hostRequirements": { "cpus": 2 }
}
