# Cloudflare response headers (https://developers.cloudflare.com/workers/static-assets/headers/)
/*
  X-Content-Type-Options: nosniff
  # no-referrer: Hugging Face answers 404 to visits that come from a workers.dev page, and the
  # portfolio has no use for telling other sites where visitors come from.
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://huggingface.co https://*.hf.co; frame-ancestors 'none'; base-uri 'self'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
